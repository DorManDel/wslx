#!/usr/bin/env bash
# WSLX command-line entry point.
#
# Responsibility:
#   1. Locate the WSLX installation/repository root.
#   2. Load shared libraries and feature modules.
#   3. Parse top-level input.
#   4. Dispatch to the correct feature.
#
# Feature behavior lives in commands/*.sh rather than growing this dispatcher.

set -euo pipefail

WSLX_BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
WSLX_REPO_CANDIDATE="$(cd -- "$WSLX_BIN_DIR/.." && pwd)"
WSLX_INSTALLED_CANDIDATE=""

if [[ -d "$WSLX_BIN_DIR/../share/wslx" ]]; then
    WSLX_INSTALLED_CANDIDATE="$(
        cd -- "$WSLX_BIN_DIR/../share/wslx"
        pwd
    )"
fi

if [[ -f "$WSLX_REPO_CANDIDATE/VERSION" && -d "$WSLX_REPO_CANDIDATE/lib" ]]; then
    WSLX_ROOT="$WSLX_REPO_CANDIDATE"
elif [[ -n "$WSLX_INSTALLED_CANDIDATE" && -f "$WSLX_INSTALLED_CANDIDATE/VERSION" ]]; then
    WSLX_ROOT="$WSLX_INSTALLED_CANDIDATE"
else
    printf 'wslx: unable to locate WSLX data files. Reinstall WSLX.\n' >&2
    exit 1
fi

# shellcheck source=lib/ui.sh
source "$WSLX_ROOT/lib/ui.sh"

# shellcheck source=lib/core.sh
source "$WSLX_ROOT/lib/core.sh"

# shellcheck source=commands/path.sh
source "$WSLX_ROOT/commands/path.sh"

show_help() {
    cat <<EOF_HELP
WSLX $(wslx_version)
Windows ↔ WSL productivity toolkit

Usage:
  wslx <command> [options]
  wslx <path>

Commands:
  path        Make a path usable in WSL
  cd          Change the current Bash directory (requires shell integration)
  doctor      Check the current WSLX environment
  version     Print the installed version
  uninstall   Remove the current user installation
  help        Show this help

Path shortcuts:
  wslx <path>          Same as: wslx path <path>
  wslx --wsl <path>    Return WSL form (default)
  wslx --win <path>    Return Windows form
  wslx --link <path>   Show a clickable Windows link in an interactive terminal

Examples:
  wslx 'D:\Programming\Test'
  wslx path '/mnt/d/Programming/Test'
  wslx --win '/mnt/d/Programming/Test'
  wslx --link '/mnt/d/Programming/Test'
  wslx doctor

Run 'wslx path --help' for path-specific help.
EOF_HELP
}

run_doctor() {
    local failures=0

    printf '%sWSLX Doctor%s\n\n' "$WSLX_BOLD" "$WSLX_RESET"

    if wslx_is_wsl; then
        wslx_success "Running inside WSL"
    else
        wslx_warn "Not running inside WSL (expected in CI or repository tests only)"
    fi

    if wslx_require_command bash; then
        wslx_success "bash is available"
    else
        wslx_error "bash is missing"
        failures=$((failures + 1))
    fi

    if [[ -f "$WSLX_ROOT/VERSION" ]]; then
        wslx_success "version file: $(wslx_version)"
    else
        wslx_error "VERSION file is missing"
        failures=$((failures + 1))
    fi

    if [[ -f "$WSLX_ROOT/docs/MAP.md" || "$WSLX_ROOT" == */share/wslx ]]; then
        wslx_success "WSLX root resolved: $WSLX_ROOT"
    else
        wslx_error "WSLX root is incomplete: $WSLX_ROOT"
        failures=$((failures + 1))
    fi

    printf '\n'
    if (( failures == 0 )); then
        wslx_success "Foundation checks passed"
    else
        wslx_error "$failures foundation check(s) failed"
    fi

    return "$failures"
}

run_uninstall() {
    if [[ ! -x "$WSLX_ROOT/uninstall.sh" ]]; then
        wslx_error "uninstaller was not found at $WSLX_ROOT/uninstall.sh"
        return 1
    fi

    exec "$WSLX_ROOT/uninstall.sh" "$@"
}

run_cd_shell_required() {
    wslx_error "cd must run through WSLX Bash integration so it can change the current shell"
    printf 'wslx: start a new Bash shell or run: source ~/.bashrc\n' >&2
    return 1
}

wslx_looks_like_path_operand() {
    local value="$1"

    [[ "$value" =~ ^[A-Za-z]:[\\/].* ]] ||
        [[ "$value" == /* ]] ||
        [[ "$value" == "." || "$value" == ".." ]] ||
        [[ "$value" == ./* || "$value" == ../* ]] ||
        [[ -e "$value" ]]
}

if (( $# == 0 )); then
    show_help
    exit 0
fi

command_name="$1"

case "$command_name" in
    help|-h|--help)
        show_help
        ;;
    version|-v|--version)
        wslx_version
        ;;
    doctor)
        shift
        run_doctor "$@"
        ;;
    path)
        shift
        wslx_path_main "$@"
        ;;
    cd)
        shift
        run_cd_shell_required "$@"
        ;;
    --wsl|--win|--link)
        wslx_path_main "$@"
        ;;
    uninstall)
        shift
        run_uninstall "$@"
        ;;
    *)
        if wslx_looks_like_path_operand "$command_name"; then
            wslx_path_main "$@"
        else
            wslx_error "Unknown command: $command_name"
            printf '\n' >&2
            show_help >&2
            exit 2
        fi
        ;;
esac
